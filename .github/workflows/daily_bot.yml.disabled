name: Daily PropTech Bot

on:
  schedule:
    # KST ?êÏ†ï(00?? = UTC 15??
    - cron: '0 15 * * *'
  workflow_dispatch:

jobs:
  daily-run:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v3
      
    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.10'
        
    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install -r pipeline/requirements.txt
        playwright install chromium --with-deps
        
    - name: Create robust .env file for bot
      run: |
        mkdir -p pipeline
        echo "SUPABASE_URL=${{ secrets.SUPABASE_URL }}" >> pipeline/.env
        echo "SUPABASE_KEY=${{ secrets.SUPABASE_KEY }}" >> pipeline/.env
        echo "RTMS_API_KEY=${{ secrets.RTMS_API_KEY }}" >> pipeline/.env
        echo "TELEGRAM_BOT_TOKEN=${{ secrets.TELEGRAM_BOT_TOKEN }}" >> pipeline/.env
        echo "TELEGRAM_CHAT_ID=${{ secrets.TELEGRAM_CHAT_ID }}" >> pipeline/.env
        
    - name: Run Master Daily Script
      env:
        TZ: "Asia/Seoul"
      run: |
        sudo apt-get install -y xvfb
        xvfb-run --auto-servernum --server-args="-screen 0 1280x1024x24" python 32_master_daily_run.py
        
    - name: Commit and Push Updated Data
      run: |
        git config --local user.email "action@github.com"
        git config --local user.name "GitHub Action Bot"
        git add web/src/data/kb50_stats.json
        git diff --quiet && git diff --staged --quiet || (git commit -m "?§ñ [Daily Bot] ?ïÏ†ï ?§Í±∞?òÍ? & ?∏Í? ?∞Ïù¥??Í∞±Ïã†" && git push)
